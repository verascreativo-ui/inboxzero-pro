# Puerto del API de extracción
PORT=8787

# Interfaz de escucha. Por defecto SOLO loopback (no publicar).
# Para un despliegue futuro, definir HOST de forma explícita. Nunca usar 0.0.0.0 por defecto.
HOST=127.0.0.1

# CORS: orígenes separados por coma. Nunca *.
# Si se omite o vale *, el servidor usa localhost:5500.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Auth del API (mismas URL + anon key públicas del proyecto; NO service_role)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Solo servidor. Nunca en el navegador. Actualiza profiles.tipo_plan y billing_subscriptions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe Billing (Checkout + webhook). Nunca en el frontend. ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:5500

# Timeouts y rate limit del API de extracción
EXTRACT_FETCH_TIMEOUT_MS=25000
EXTRACT_REQUEST_TIMEOUT_MS=40000
EXTRACT_RATE_LIMIT_WINDOW_MS=600000
EXTRACT_RATE_LIMIT_MAX=40
EXTRACT_JSON_LIMIT=32kb

# Proveedor activo: scrapingbee | zenrows | puppeteer | auto
SCRAPE_PROVIDER=auto

# Clave genérica (alias de ScrapingBee si no defines SCRAPINGBEE_API_KEY)
SCRAPE_API_KEY=

# --- ScrapingBee (proxy residencial + JS render + wait_for=h1) ---
# https://www.scrapingbee.com/
SCRAPINGBEE_API_KEY=

# --- ZenRows (premium proxy + JS render) ---
# https://www.zenrows.com/
ZENROWS_API_KEY=

# País del proxy residencial (ISO-2)
PROXY_COUNTRY=es

# Puppeteer stealth local (opcional)
ENABLE_PUPPETEER=0
